@*
    Họ và tên: [Trần Công Quang Đăng]
    Mã sinh viên: [23203100040]
    Nội dung thực hiện: Module 3 - Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở
*@
@model DangKyDetailsVM
@{
    ViewData["Title"] = "Chi tiết đăng ký";
    var d = Model.DangKy;
}
<h2>Đăng ký #@d.MaDangKy</h2>
<div class="card shadow-sm mb-3" style="max-width:720px"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">Sinh viên</dt><dd class="col-sm-8">@d.SinhVien.HoTen (@d.MaSinhVien) - @d.SinhVien.GioiTinh</dd>
        <dt class="col-sm-4">Ngày đăng ký</dt><dd class="col-sm-8">@Fmt.NgayGio(d.NgayDangKy)</dd>
        <dt class="col-sm-4">Thời gian ở</dt><dd class="col-sm-8">@Fmt.Ngay(d.NgayBatDau) &rarr; @Fmt.Ngay(d.NgayKetThucDuKien)</dd>
        <dt class="col-sm-4">Nguyện vọng</dt>
<dd class="col-sm-8">
    @if (d.PhongNguyenVong != null)
    {
        <strong>Phòng @d.PhongNguyenVong.TenPhong</strong>
        <span class="text-muted">(Tòa @d.PhongNguyenVong.ToaNha, tầng @d.PhongNguyenVong.Tang)</span>
        @if (d.LoaiPhongNguyenVong != null) { <span class="text-muted small">- @d.LoaiPhongNguyenVong.TenLoaiPhong</span> }
    }
    else { @(d.LoaiPhongNguyenVong?.TenLoaiPhong ?? "—") }
</dd>
        <dt class="col-sm-4">Ghi chú</dt><dd class="col-sm-8">@d.GhiChu</dd>
        <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8"><span class="badge @Fmt.Badge(d.TrangThai)">@d.TrangThai</span></dd>
    </dl>
</div></div>

<h5>Lịch sử phân phòng của đăng ký này</h5>
@if (!Model.LichSu.Any())
{
    <div class="alert alert-secondary">Đăng ký chưa được phân phòng.</div>
}
else
{
    <div class="card shadow-sm"><div class="table-responsive"><table class="table mb-0">
        <thead class="table-light"><tr><th>Phòng</th><th>Loại phòng</th><th>Ngày vào</th><th>Ngày ra</th><th>Trạng thái</th></tr></thead>
        <tbody>
        @foreach (var pp in Model.LichSu)
        {
            <tr><td>@pp.PhongKTX.TenPhong (Tòa @pp.PhongKTX.ToaNha, tầng @pp.PhongKTX.Tang)</td><td>@pp.PhongKTX.LoaiPhong.TenLoaiPhong</td><td>@Fmt.Ngay(pp.NgayVao)</td><td>@Fmt.Ngay(pp.NgayRa)</td><td><span class="badge @Fmt.Badge(pp.TrangThai)">@pp.TrangThai</span></td></tr>
        }
        </tbody>
    </table></div></div>
}
<div class="mt-3">
    @if (Model.LaAdmin)
    {
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
        @if (d.TrangThai == TrangThaiDangKy.ChoDuyet)
        {
            <a class="btn btn-success" asp-controller="PhanPhong" asp-action="Create" asp-route-maDangKy="@d.MaDangKy">Phân phòng</a>
        }
    }
    else
    {
        <a class="btn btn-outline-secondary" asp-action="CuaToi">Quay lại</a>
    }
</div>
