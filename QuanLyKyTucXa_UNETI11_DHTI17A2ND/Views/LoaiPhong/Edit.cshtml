@*
    Họ và tên: [Nguyễn Văn Cường]
    Mã sinh viên: [23203100019]
    Nội dung thực hiện: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng
*@
@model LoaiPhong
@{
    ViewData["Title"] = "Sửa loại phòng";
}
<h2>Sửa loại phòng</h2>
<div class="row"><div class="col-md-7"><div class="card shadow-sm"><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.MaLoaiPhong" method="post">
        <input type="hidden" asp-for="MaLoaiPhong" />
        <partial name="_Form" model="Model" />
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
    </form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
