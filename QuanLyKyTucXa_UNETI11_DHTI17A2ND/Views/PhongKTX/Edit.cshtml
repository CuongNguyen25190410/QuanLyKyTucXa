@*
    Họ và tên: [Trần Hoàng Sơn]
    Mã sinh viên: [23203100010]
    Nội dung thực hiện: Module 2 - Quản lý phòng KTX, tìm kiếm, lọc, sắp xếp, phân trang
*@
@model PhongKTX
@{
    ViewData["Title"] = "Sửa phòng";
}
<h2>Sửa phòng @Model.TenPhong</h2>
@if ((int)ViewBag.SoDangO > 0)
{
    <div class="alert alert-info">Phòng đang có <strong>@ViewBag.SoDangO</strong> sinh viên ở: không thể đổi giới tính phòng hoặc tạm ngừng.</div>
}
<div class="row"><div class="col-md-8"><div class="card shadow-sm"><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.MaPhong" method="post">
        <input type="hidden" asp-for="MaPhong" />
        <partial name="_Form" model="Model" />
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
    </form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
