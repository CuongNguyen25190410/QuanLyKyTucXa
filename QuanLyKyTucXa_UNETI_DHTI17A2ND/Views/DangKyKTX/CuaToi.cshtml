@*
    Họ và tên: [Trần Công Quang Đăng]
    Mã sinh viên: [23203100040]
    Nội dung thực hiện: Module 3 - Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở
*@
@model List<DangKyKTX>
@{
    ViewData["Title"] = "Đăng ký của tôi";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Đăng ký ở KTX của tôi</h2>
    <a class="btn btn-primary" asp-action="Create">+ Đăng ký mới</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">Bạn chưa có đăng ký nào. Hãy xem <a asp-controller="PhongKTX" asp-action="Index" asp-route-conCho="con">danh sách phòng còn chỗ</a> rồi gửi đăng ký.</div>
}
else
{
    <div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Mã ĐK</th><th>Ngày đăng ký</th><th>Bắt đầu</th><th>Kết thúc dự kiến</th><th>Nguyện vọng</th><th>Phòng hiện tại</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model)
        {
            var phong = d.PhanPhongs.FirstOrDefault(pp => pp.TrangThai == TrangThaiPhanPhong.DangO);
            <tr>
                <td>@d.MaDangKy</td><td>@Fmt.NgayGio(d.NgayDangKy)</td><td>@Fmt.Ngay(d.NgayBatDau)</td><td>@Fmt.Ngay(d.NgayKetThucDuKien)</td>
                <td>@(d.PhongNguyenVong != null ? "Phòng " + d.PhongNguyenVong.TenPhong : (d.LoaiPhongNguyenVong?.TenLoaiPhong ?? "—"))</td>
                <td>@(phong != null ? phong.PhongKTX.TenPhong : "—")</td>
                <td><span class="badge @Fmt.Badge(d.TrangThai)">@d.TrangThai</span></td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@d.MaDangKy">Chi tiết</a>
                    @if (d.TrangThai == TrangThaiDangKy.ChoDuyet)
                    {
                        <form asp-action="Huy" asp-route-id="@d.MaDangKy" method="post" class="d-inline" onsubmit="return confirm('Hủy đăng ký này?');">
                            <button class="btn btn-sm btn-outline-danger">Hủy</button>
                        </form>
                    }
                    @if (d.TrangThai == TrangThaiDangKy.DaPhanPhong)
                    {
                        if (d.DonHuyPhongs.Any(x => x.TrangThai == TrangThaiDonHuy.ChoDuyet))
                        {
                            <a class="btn btn-sm btn-warning" asp-controller="DonHuyPhong" asp-action="CuaToi">Đơn hủy đang chờ duyệt</a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-danger" asp-controller="DonHuyPhong" asp-action="Create" asp-route-maDangKy="@d.MaDangKy">Xin hủy phòng</a>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
}