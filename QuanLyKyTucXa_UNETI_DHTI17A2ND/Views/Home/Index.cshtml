@*
    Họ và tên: [ĐIỀN HỌ TÊN CẢ NHÓM]
    Mã sinh viên: [ĐIỀN MÃ CẢ NHÓM]
    Nội dung thực hiện: Thành phần dùng chung của Project (cấu hình, DbContext, dữ liệu mẫu, layout...)
*@
@{
    ViewData["Title"] = "Trang chủ";
    var dangNhap = Context.Session.GetInt32("MaTaiKhoan") != null;
    var vaiTro = Context.Session.GetString("VaiTro");
}

<style>
    /* ===== Banner ===== */
    .hm-hero {
        color: #fff;
        border-radius: 20px;
        padding: 2.5rem;
        background:
            radial-gradient(circle at 15% 0%, rgba(255,255,255,.18) 0, transparent 40%),
            radial-gradient(circle at 95% 100%, rgba(255,255,255,.12) 0, transparent 45%),
            linear-gradient(135deg, #1e88e5 0%, #1565c0 55%, #0d47a1 100%);
        box-shadow: 0 14px 34px rgba(13, 71, 161, .25);
    }
    .hm-hero h1 { font-weight: 700; font-size: 2rem; line-height: 1.3; }
    .hm-hero .lead { color: rgba(255,255,255,.88); font-size: 1.05rem; }
    .hm-hero .btn { border-radius: 999px; padding: .55rem 1.3rem; font-weight: 600; }
    .hm-hero .btn-light { color: #0d47a1; }

    .hm-stat {
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        height: 100%;
    }
    .hm-stat i { font-size: 1.8rem; opacity: .9; }
    .hm-stat .num { font-size: 3.2rem; font-weight: 700; line-height: 1.1; }
    .hm-stat .lbl { color: rgba(255,255,255,.85); font-size: .9rem; }

    /* ===== Quy trình ===== */
    .hm-section-title { color: #0d47a1; font-weight: 700; }
    .hm-phase {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(13, 71, 161, .08);
        height: 100%;
        overflow: hidden;
    }
    .hm-phase-head {
        padding: .9rem 1.25rem;
        background: #e3f0ff;
        color: #0d47a1;
        font-weight: 700;
        display: flex; align-items: center; gap: .5rem;
    }
    .hm-phase-head .tag {
        background: #1565c0; color: #fff;
        font-size: .72rem; padding: .15rem .55rem; border-radius: 999px;
    }
    .hm-steps { list-style: none; margin: 0; padding: 1.25rem; }
    .hm-step {
        position: relative;
        display: flex; gap: .9rem;
        padding-bottom: 1.4rem;
    }
    .hm-step:last-child { padding-bottom: 0; }
    .hm-step::before {                 /* đường nối giữa các bước */
        content: "";
        position: absolute;
        left: 19px; top: 42px; bottom: 2px;
        width: 2px;
        background: #cfe0f5;
    }
    .hm-step:last-child::before { display: none; }
    .hm-num {
        flex: 0 0 40px; height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1e88e5, #1565c0);
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
        box-shadow: 0 3px 8px rgba(21, 101, 192, .3);
    }
    .hm-step.optional .hm-num {
        background: #fff; color: #1565c0;
        border: 2px dashed #1e88e5;
        box-shadow: none;
    }
    .hm-step h6 { margin: 0 0 .15rem; font-weight: 700; color: #1b2a41; }
    .hm-step p { margin: 0; color: #6b7a90; font-size: .88rem; }
    .hm-opt-badge {
        background: #fff3cd; color: #8a6d00;
        font-size: .68rem; font-weight: 600;
        padding: .1rem .45rem; border-radius: 999px;
        margin-left: .35rem; vertical-align: middle;
    }

    @@media (max-width: 767.98px) {
        .hm-hero { padding: 1.5rem; }
        .hm-hero h1 { font-size: 1.5rem; }
    }
</style>

<!-- ===== Banner ===== -->
<div class="hm-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-lg-8">
            <h1 class="mb-3">Hệ thống quản lý ký túc xá và phân phòng sinh viên</h1>
            <p class="lead mb-4">Xem phòng còn chỗ, đăng ký ở ký túc xá và theo dõi quá trình phân phòng trực tuyến.</p>

            @if (!dangNhap)
            {
                <a class="btn btn-light btn-lg" asp-controller="TaiKhoan" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập để bắt đầu</a>
            }
            else if (vaiTro == VaiTro.Admin)
            {
                <a class="btn btn-light me-2 mb-2" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i> Mở Dashboard</a>
                <a class="btn btn-outline-light me-2 mb-2" asp-controller="DangKyKTX" asp-action="Index" asp-route-trangThai="@TrangThaiDangKy.ChoDuyet"><i class="bi bi-journal-check me-1"></i> Duyệt đăng ký</a>
                <a class="btn btn-outline-light mb-2" asp-controller="PhongKTX" asp-action="Index"><i class="bi bi-door-open me-1"></i> Quản lý phòng</a>
            }
            else
            {
                <a class="btn btn-light me-2 mb-2" asp-controller="PhongKTX" asp-action="Index" asp-route-conCho="con"><i class="bi bi-search me-1"></i> Xem phòng còn chỗ</a>
                <a class="btn btn-outline-light me-2 mb-2" asp-controller="DangKyKTX" asp-action="Create"><i class="bi bi-pencil-square me-1"></i> Đăng ký ở KTX</a>
                <a class="btn btn-outline-light mb-2" asp-controller="CaNhan" asp-action="Index"><i class="bi bi-person-vcard me-1"></i> Thông tin cá nhân</a>
            }
        </div>
        <div class="col-lg-4">
            <div class="hm-stat">
                <i class="bi bi-door-open-fill"></i>
                <div class="num">@ViewBag.SoPhongConCho</div>
                <div class="lbl">phòng đang sử dụng và còn khả năng tiếp nhận</div>
            </div>
        </div>
    </div>
</div>

<!-- ===== Quy trình đăng ký ===== -->
<h4 class="hm-section-title mb-1"><i class="bi bi-signpost-split me-2"></i>Quy trình đăng ký ký túc xá</h4>
<p class="text-muted mb-3">Chỉ cần đi qua 3 giai đoạn, từ lúc đăng nhập đến khi trả phòng.</p>

<div class="row g-3">
    <!-- Giai đoạn 1 -->
    <div class="col-lg-4">
        <div class="hm-phase">
            <div class="hm-phase-head"><span class="tag">GIAI ĐOẠN 1</span> Đăng ký</div>
            <ul class="hm-steps">
                <li class="hm-step">
                    <span class="hm-num"><i class="bi bi-box-arrow-in-right"></i></span>
                    <div><h6>1. Đăng nhập</h6><p>Đăng nhập bằng mã sinh viên và mật khẩu của bạn.</p></div>
                </li>
                <li class="hm-step">
                    <span class="hm-num"><i class="bi bi-search"></i></span>
                    <div><h6>2. Xem phòng</h6><p>Tìm phòng còn chỗ trong danh sách phòng.</p></div>
                </li>
                <li class="hm-step">
                    <span class="hm-num"><i class="bi bi-pencil-square"></i></span>
                    <div><h6>3. Đăng ký KTX</h6><p>Điền và gửi đơn đăng ký ở ký túc xá.</p></div>
                </li>
            </ul>
        </div>
    </div>

    <!-- Giai đoạn 2 -->
    <div class="col-lg-4">
        <div class="hm-phase">
            <div class="hm-phase-head"><span class="tag">GIAI ĐOẠN 2</span> Xét duyệt</div>
            <ul class="hm-steps">
                <li class="hm-step">
                    <span class="hm-num"><i class="bi bi-hourglass-split"></i></span>
                    <div><h6>4. Chờ duyệt</h6><p>Quản trị viên xem xét đơn đăng ký của bạn.</p></div>
                </li>
                <li class="hm-step">
                    <span class="hm-num"><i class="bi bi-check2-circle"></i></span>
                    <div><h6>5. Được phân phòng</h6><p>Khi đơn được duyệt, bạn được xếp vào một phòng cụ thể.</p></div>
                </li>
            </ul>
        </div>
    </div>

    <!-- Giai đoạn 3 -->
    <div class="col-lg-4">
        <div class="hm-phase">
            <div class="hm-phase-head"><span class="tag">GIAI ĐOẠN 3</span> Lưu trú</div>
            <ul class="hm-steps">
                <li class="hm-step">
                    <span class="hm-num"><i class="bi bi-house-heart"></i></span>
                    <div><h6>6. Ở KTX</h6><p>Bắt đầu thời gian lưu trú tại ký túc xá.</p></div>
                </li>
                <li class="hm-step optional">
                    <span class="hm-num"><i class="bi bi-arrow-left-right"></i></span>
                    <div><h6>7. Chuyển phòng<span class="hm-opt-badge">Tùy chọn</span></h6><p>Nếu cần, chuyển sang một phòng khác.</p></div>
                </li>
                <li class="hm-step">
                    <span class="hm-num"><i class="bi bi-box-arrow-right"></i></span>
                    <div><h6>8. Trả phòng</h6><p>Kết thúc thời gian ở và trả phòng.</p></div>
                </li>
                <li class="hm-step">
                    <span class="hm-num"><i class="bi bi-clock-history"></i></span>
                    <div><h6>9. Xem lịch sử</h6><p>Xem lại các phòng đã ở trong mục "Lịch sử ở".</p></div>
                </li>
            </ul>
        </div>
    </div>
</div>