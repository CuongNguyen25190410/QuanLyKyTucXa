@*
    Họ và tên: [ĐIỀN HỌ TÊN CẢ NHÓM]
    Mã sinh viên: [ĐIỀN MÃ CẢ NHÓM]
    Nội dung thực hiện: Thành phần dùng chung của Project (cấu hình, DbContext, dữ liệu mẫu, layout...)
*@
@{
    ViewData["Title"] = "Trang chủ";
    var dangNhap = Context.Session.GetInt32("MaTaiKhoan") != null;
    var vaiTro = Context.Session.GetString("VaiTro");
}
<div class="p-5 mb-4 bg-white rounded-3 shadow-sm">
    <h1 class="display-6 fw-bold">Hệ thống quản lý ký túc xá và phân phòng sinh viên</h1>
    <p class="lead text-muted mb-4">Xem phòng còn chỗ, đăng ký ở ký túc xá và theo dõi quá trình phân phòng trực tuyến.</p>

    @if (!dangNhap)
    {
        <a class="btn btn-primary btn-lg" asp-controller="TaiKhoan" asp-action="Login">Đăng nhập để bắt đầu</a>
    }
    else if (vaiTro == VaiTro.Admin)
    {
        <a class="btn btn-primary me-2" asp-controller="ThongKe" asp-action="Index">Mở Dashboard</a>
        <a class="btn btn-outline-primary me-2" asp-controller="DangKyKTX" asp-action="Index" asp-route-trangThai="@TrangThaiDangKy.ChoDuyet">Duyệt đăng ký</a>
        <a class="btn btn-outline-primary" asp-controller="PhongKTX" asp-action="Index">Quản lý phòng</a>
    }
    else
    {
        <a class="btn btn-primary me-2" asp-controller="PhongKTX" asp-action="Index" asp-route-conCho="con">Xem phòng còn chỗ</a>
        <a class="btn btn-outline-primary me-2" asp-controller="DangKyKTX" asp-action="Create">Đăng ký ở KTX</a>
        <a class="btn btn-outline-primary" asp-controller="CaNhan" asp-action="Index">Thông tin cá nhân</a>
    }
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm h-100"><div class="card-body">
            <h5 class="card-title">Phòng còn chỗ</h5>
            <p class="display-6 mb-1">@ViewBag.SoPhongConCho</p>
            <p class="text-muted mb-0">phòng đang sử dụng và còn khả năng tiếp nhận.</p>
        </div></div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm h-100"><div class="card-body">
            <h5 class="card-title">Quy trình đăng ký</h5>
            <p class="mb-0">Đăng nhập &rarr; Xem phòng &rarr; Đăng ký KTX &rarr; Chờ duyệt &rarr; Được phân phòng &rarr; Ở KTX &rarr; (Chuyển phòng) &rarr; Trả phòng &rarr; Xem lịch sử.</p>
        </div></div>
    </div>
</div>
