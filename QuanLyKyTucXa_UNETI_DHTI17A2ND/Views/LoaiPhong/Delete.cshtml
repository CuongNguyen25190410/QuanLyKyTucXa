@*
    Họ và tên: [Nguyễn Văn Cường]
    Mã sinh viên: [23203100019]
    Nội dung thực hiện: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng
*@
@model LoaiPhong
@{
    ViewData["Title"] = "Xóa loại phòng";
}
<h2>Xóa loại phòng</h2>
<div class="alert alert-warning">Bạn có chắc muốn xóa loại phòng <strong>@Model.TenLoaiPhong</strong>?
    @if ((int)ViewBag.SoPhong > 0)
    {
        <div class="mt-2"><strong>Lưu ý:</strong> hiện có @ViewBag.SoPhong phòng thuộc loại này nên hệ thống sẽ không cho xóa.</div>
    }
</div>
<form asp-action="Delete" asp-route-id="@Model.MaLoaiPhong" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
</form>
