@*
    Họ và tên: [Hà Việt Anh]
    Mã sinh viên: [23203100046]
    Nội dung thực hiện: Module 4 - Quản lý đăng ký, phân phòng, chuyển phòng, trả phòng, Dashboard, thống kê
*@
@model ChuyenPhongVM
@{
    ViewData["Title"] = "Chuyển phòng";
    var h = Model.HienTai;
}
<h2>Chuyển phòng</h2>
<div class="card shadow-sm mb-3"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Sinh viên</dt><dd class="col-sm-9">@h.DangKyKTX.SinhVien.HoTen (@h.DangKyKTX.MaSinhVien) - @h.DangKyKTX.SinhVien.GioiTinh</dd>
        <dt class="col-sm-3">Phòng hiện tại</dt><dd class="col-sm-9">@h.PhongKTX.TenPhong - @h.PhongKTX.LoaiPhong.TenLoaiPhong (Tòa @h.PhongKTX.ToaNha, tầng @h.PhongKTX.Tang, @h.PhongKTX.GioiTinhPhong)</dd>
        <dt class="col-sm-3">Vào phòng từ</dt><dd class="col-sm-9">@Fmt.Ngay(h.NgayVao)</dd>
    </dl>
</div></div>
<div class="alert alert-info small">Bản ghi ở phòng cũ sẽ chuyển thành "Đã chuyển" kèm ngày ra, đồng thời tạo bản ghi mới ở phòng mới để giữ lịch sử.</div>
<form asp-action="Chuyen" method="post" class="card shadow-sm"><div class="card-body">
    <input type="hidden" asp-for="MaPhanPhong" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row">
        <div class="col-md-8 mb-3">
            <label asp-for="MaPhongMoi" class="form-label"></label>
            <select asp-for="MaPhongMoi" asp-items="Model.PhongCoTheChon" class="form-select"><option value="">-- Chọn phòng mới --</option></select>
            <span asp-validation-for="MaPhongMoi" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="NgayChuyen" class="form-label"></label>
            <input asp-for="NgayChuyen" type="date" class="form-control" />
            <span asp-validation-for="NgayChuyen" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Xác nhận chuyển phòng</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
</div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
