@*
    Họ và tên: [ĐIỀN HỌ TÊN SV4]
    Mã sinh viên: [ĐIỀN MÃ SV4]
    Nội dung thực hiện: Module 4 - Quản lý đăng ký, phân phòng, chuyển phòng, trả phòng, Dashboard, thống kê
*@
@model PhanPhongIndexVM
@{
    ViewData["Title"] = "Phân phòng";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Phân phòng - Chuyển phòng - Trả phòng</h2>
    <a class="btn btn-success" asp-controller="DangKyKTX" asp-action="Index" asp-route-trangThai="@TrangThaiDangKy.ChoDuyet">Duyệt đăng ký chờ phân phòng</a>
</div>
<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-5"><input name="tuKhoa" value="@Model.TuKhoa" class="form-control" placeholder="Mã SV, họ tên hoặc tên phòng..." /></div>
    <div class="col-md-3">
        <select name="trangThai" class="form-select">
            <option value="all" selected="@(Model.TrangThai == "all")">-- Tất cả (kể cả lịch sử) --</option>
            @foreach (var t in TrangThaiPhanPhong.TatCa) { <option value="@t" selected="@(Model.TrangThai == t)">@t</option> }
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Lọc</button></div>
</form>

@if (!Model.KetQua.Items.Any())
{
    <div class="alert alert-info">Không có bản ghi phân phòng nào phù hợp.</div>
}
else
{
    <div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Sinh viên</th><th>Giới tính</th><th>Phòng</th><th>Loại phòng</th><th>Ngày vào</th><th>Ngày ra</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var pp in Model.KetQua.Items)
        {
            <tr>
                <td>@pp.DangKyKTX.SinhVien.HoTen<br /><span class="text-muted small">@pp.DangKyKTX.MaSinhVien</span></td>
                <td>@pp.DangKyKTX.SinhVien.GioiTinh</td>
                <td>@pp.PhongKTX.TenPhong <span class="text-muted small">(Tòa @pp.PhongKTX.ToaNha, tầng @pp.PhongKTX.Tang)</span></td>
                <td>@pp.PhongKTX.LoaiPhong.TenLoaiPhong</td>
                <td>@Fmt.Ngay(pp.NgayVao)</td><td>@Fmt.Ngay(pp.NgayRa)</td>
                <td><span class="badge @Fmt.Badge(pp.TrangThai)">@pp.TrangThai</span></td>
                <td class="text-end text-nowrap">
                    @* Nút chỉ hiện khi trạng thái cho phép; Controller/Service vẫn kiểm tra lại *@
                    @if (pp.TrangThai == TrangThaiPhanPhong.DangO)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Chuyen" asp-route-id="@pp.MaPhanPhong">Chuyển phòng</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Tra" asp-route-id="@pp.MaPhanPhong">Trả phòng</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
}
<partial name="_Pager" model="Model.KetQua" />
