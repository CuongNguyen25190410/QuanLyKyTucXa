@*
    Họ và tên: [ĐIỀN HỌ TÊN SV2]
    Mã sinh viên: [ĐIỀN MÃ SV2]
    Nội dung thực hiện: Module 2 - Quản lý phòng KTX, tìm kiếm, lọc, sắp xếp, phân trang
*@
@model PhongIndexVM
@{
    ViewData["Title"] = "Danh sách phòng";
    var f = Model.Filter;
    var sapXeps = new (string Gia, string Nhan)[]
    {
        ("ten_asc", "Tên phòng A → Z"), ("ten_desc", "Tên phòng Z → A"),
        ("tang_asc", "Tầng tăng dần"), ("tang_desc", "Tầng giảm dần"),
        ("cho_asc", "Số chỗ còn tăng dần"), ("cho_desc", "Số chỗ còn giảm dần")
    };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@(Model.LaAdmin ? "Quản lý phòng ký túc xá" : "Danh sách phòng")</h2>
    @if (Model.LaAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">+ Thêm phòng</a>
    }
</div>

@* Một form GET duy nhất: từ khóa + các điều kiện lọc + kiểu sắp xếp. Chuyển trang vẫn giữ các giá trị này. *@
<form method="get" asp-action="Index" class="card shadow-sm mb-3"><div class="card-body">
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label small mb-1">Tìm kiếm (tên phòng / tòa nhà)</label>
            <input name="tuKhoa" value="@f.TuKhoa" class="form-control" placeholder="VD: A101 hoặc tòa B" />
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Loại phòng</label>
            <select name="maLoaiPhong" class="form-select">
                <option value="">-- Tất cả --</option>
                @foreach (var x in Model.LoaiPhongs)
                {
                    <option value="@x.Value" selected="@(f.MaLoaiPhong?.ToString() == x.Value)">@x.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Tòa nhà</label>
            <select name="toaNha" class="form-select">
                <option value="">-- Tất cả --</option>
                @foreach (var x in Model.ToaNhas)
                {
                    <option value="@x.Value" selected="@(f.ToaNha == x.Value)">Tòa @x.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Tầng</label>
            <select name="tang" class="form-select">
                <option value="">-- Tất cả --</option>
                @foreach (var x in Model.Tangs)
                {
                    <option value="@x.Value" selected="@(f.Tang?.ToString() == x.Value)">@x.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Giới tính phòng</label>
            <select name="gioiTinh" class="form-select">
                <option value="">-- Tất cả --</option>
                @foreach (var g in GioiTinh.TatCa)
                {
                    <option value="@g" selected="@(f.GioiTinh == g)">@g</option>
                }
            </select>
        </div>
        @if (Model.LaAdmin)
        {
            <div class="col-md-2">
                <label class="form-label small mb-1">Trạng thái</label>
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả --</option>
                    @foreach (var t in TrangThaiPhong.TatCa)
                    {
                        <option value="@t" selected="@(f.TrangThai == t)">@t</option>
                    }
                </select>
            </div>
        }
        <div class="col-md-2">
            <label class="form-label small mb-1">Còn chỗ / Hết chỗ</label>
            <select name="conCho" class="form-select">
                <option value="">-- Tất cả --</option>
                <option value="con" selected="@(f.ConCho == "con")">Còn chỗ</option>
                <option value="het" selected="@(f.ConCho == "het")">Hết chỗ</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Sắp xếp</label>
            <select name="sapXep" class="form-select">
                @foreach (var s in sapXeps)
                {
                    <option value="@s.Gia" selected="@(f.SapXep == s.Gia)">@s.Nhan</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button class="btn btn-primary flex-fill">Áp dụng</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a>
        </div>
    </div>
</div></form>

@if (!Model.KetQua.Items.Any())
{
    <div class="alert alert-info">Không tìm thấy phòng nào phù hợp với điều kiện đã chọn.</div>
}
else
{
    <div class="card shadow-sm"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Phòng</th><th>Loại phòng</th><th>Tòa</th><th>Tầng</th><th>Giới tính</th>
                    <th class="text-center">Đang ở / Sức chứa</th><th class="text-center">Chỗ còn</th>
                    @if (Model.LaAdmin) { <th>Trạng thái</th> }
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.KetQua.Items)
            {
                <tr>
                    <td class="fw-semibold">@p.TenPhong</td>
                    <td>@p.TenLoaiPhong<br /><span class="text-muted small">@Fmt.Tien(p.DonGiaThang)/tháng</span></td>
                    <td>@p.ToaNha</td>
                    <td>@p.Tang</td>
                    <td>@p.GioiTinhPhong</td>
                    <td class="text-center">@p.SoDangO / @p.SucChua</td>
                    <td class="text-center">
                        @if (p.SoChoCon > 0)
                        {
                            <span class="badge bg-success">Còn @p.SoChoCon chỗ</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Hết chỗ</span>
                        }
                    </td>
                    @if (Model.LaAdmin) { <td><span class="badge @Fmt.Badge(p.TrangThai)">@p.TrangThai</span></td> }
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.MaPhong">Chi tiết</a>
                        @if (Model.LaAdmin)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.MaPhong">Sửa</a>
                            <form asp-action="DoiTrangThai" asp-route-id="@p.MaPhong" method="post" class="d-inline">
                                <input type="hidden" name="returnQuery" value="@Context.Request.QueryString.Value" />
                                <button class="btn btn-sm btn-outline-warning">@(p.TrangThai == TrangThaiPhong.DangSuDung ? "Tạm ngừng" : "Mở lại")</button>
                            </form>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.MaPhong">Xóa</a>
                        }
                        else if (p.SoChoCon > 0)
                        {
                            <a class="btn btn-sm btn-success" asp-controller="DangKyKTX" asp-action="Create" asp-route-maLoaiPhong="@p.MaLoaiPhong">Đăng ký</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
}
<partial name="_Pager" model="Model.KetQua" />
