@*
    Họ và tên: [ĐIỀN HỌ TÊN SV2]
    Mã sinh viên: [ĐIỀN MÃ SV2]
    Nội dung thực hiện: Module 2 - Quản lý phòng KTX, tìm kiếm, lọc, sắp xếp, phân trang
*@
@model PhongKTX
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="TenPhong" class="form-label"></label><input asp-for="TenPhong" class="form-control" /><span asp-validation-for="TenPhong" class="text-danger"></span></div>
    <div class="col-md-6 mb-3">
        <label asp-for="MaLoaiPhong" class="form-label"></label>
        <select asp-for="MaLoaiPhong" asp-items="@((List<SelectListItem>)ViewBag.LoaiPhongs)" class="form-select"><option value="">-- Chọn loại phòng --</option></select>
        <span asp-validation-for="MaLoaiPhong" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="ToaNha" class="form-label"></label><input asp-for="ToaNha" class="form-control" placeholder="VD: A" /><span asp-validation-for="ToaNha" class="text-danger"></span></div>
    <div class="col-md-6 mb-3"><label asp-for="Tang" class="form-label"></label><input asp-for="Tang" type="number" min="1" max="30" class="form-control" /><span asp-validation-for="Tang" class="text-danger"></span></div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="GioiTinhPhong" class="form-label d-block"></label>
        @foreach (var g in GioiTinh.TatCa)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="GioiTinhPhong" value="@g" />
                <label class="form-check-label">@g</label>
            </div>
        }
        <span asp-validation-for="GioiTinhPhong" class="text-danger d-block"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="TrangThai" class="form-label"></label>
        <select asp-for="TrangThai" asp-items="@((List<SelectListItem>)ViewBag.TrangThais)" class="form-select"></select>
        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>
</div>
<div class="mb-3"><label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" rows="3" class="form-control"></textarea><span asp-validation-for="MoTa" class="text-danger"></span></div>
<p class="text-muted small">Số chỗ còn không nhập tay: hệ thống tự tính = sức chứa của loại phòng − số sinh viên đang ở.</p>
