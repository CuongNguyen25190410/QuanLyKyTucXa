@*
    Họ và tên: [ĐIỀN HỌ TÊN SV3]
    Mã sinh viên: [ĐIỀN MÃ SV3]
    Nội dung thực hiện: Module 3 - Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở
*@
@model PagedResult<SinhVien>
@{
    ViewData["Title"] = "Quản lý sinh viên";
    var dangO = (Dictionary<string, string>)ViewBag.DangO;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Quản lý sinh viên</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-success" asp-controller="ImportSinhVien" asp-action="Index">
            <i class="bi bi-file-earmark-excel"></i> Nhập từ Excel
        </a>
        <a class="btn btn-primary" asp-action="Create">+ Thêm sinh viên</a>
    </div>
</div>
<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4"><input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Mã SV, họ tên, lớp..." /></div>
    <div class="col-md-2">
        <select name="gioiTinh" class="form-select">
            <option value="">-- Giới tính --</option>
            @foreach (var g in GioiTinh.TatCa) { <option value="@g" selected="@(ViewBag.GioiTinh == g)">@g</option> }
        </select>
    </div>
    <div class="col-md-3">
        <select name="trangThai" class="form-select">
            <option value="">-- Trạng thái --</option>
            <option value="@TrangThaiSinhVien.HoatDong" selected="@(ViewBag.TrangThai == TrangThaiSinhVien.HoatDong)">@TrangThaiSinhVien.HoatDong</option>
            <option value="@TrangThaiSinhVien.NgungHoatDong" selected="@(ViewBag.TrangThai == TrangThaiSinhVien.NgungHoatDong)">@TrangThaiSinhVien.NgungHoatDong</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Tìm</button></div>
</form>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">Không tìm thấy sinh viên nào phù hợp.</div>
}
else
{
    <div class="card shadow-sm"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Mã SV</th><th>Họ tên</th><th>Ngày sinh</th><th>Giới tính</th><th>Lớp</th><th>SĐT</th><th>Phòng đang ở</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model.Items)
            {
                <tr>
                    <td>@s.MaSinhVien</td><td>@s.HoTen</td><td>@Fmt.Ngay(s.NgaySinh)</td><td>@s.GioiTinh</td><td>@s.Lop</td><td>@s.SoDienThoai</td>
                    <td>@(dangO.ContainsKey(s.MaSinhVien) ? dangO[s.MaSinhVien] : "—")</td>
                    <td><span class="badge @Fmt.Badge(s.TrangThai)">@s.TrangThai</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@s.MaSinhVien">Chi tiết</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.MaSinhVien">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.MaSinhVien">Xóa</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
}
<partial name="_Pager" model="Model" />
