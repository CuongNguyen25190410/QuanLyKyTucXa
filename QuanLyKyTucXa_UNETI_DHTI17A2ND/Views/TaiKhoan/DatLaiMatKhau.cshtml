@*
    Họ và tên: [ĐIỀN HỌ TÊN SV1]
    Mã sinh viên: [ĐIỀN MÃ SV1]
    Nội dung thực hiện: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng
*@
@model DatLaiMatKhauVM
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<h2>Đặt lại mật khẩu: @Model.TenDangNhap</h2>
<div class="row"><div class="col-md-6"><div class="card shadow-sm"><div class="card-body">
    <form asp-action="DatLaiMatKhau" method="post">
        <input type="hidden" asp-for="MaTaiKhoan" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3"><label asp-for="MatKhauMoi" class="form-label"></label><input asp-for="MatKhauMoi" class="form-control" /><span asp-validation-for="MatKhauMoi" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="XacNhanMatKhau" class="form-label"></label><input asp-for="XacNhanMatKhau" class="form-control" /><span asp-validation-for="XacNhanMatKhau" class="text-danger"></span></div>
        <button type="submit" class="btn btn-primary">Đặt lại</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
    </form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
