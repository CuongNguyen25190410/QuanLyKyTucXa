@*
    Họ và tên: [ĐIỀN HỌ TÊN SV1]
    Mã sinh viên: [ĐIỀN MÃ SV1]
    Nội dung thực hiện: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng
*@
@model LoginVM

@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý KTX</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
            :root {
                --navy: #071f4d;
                --blue-700: #0d47a1;
                --blue-600: #1565c0;
                --blue-500: #1e88e5;
                --sky: #4fc3f7;
                --amber: #ffb703;
                --ink: #1b2a41;
                --muted: #6b7a90;
                --line: #d9e6f7;
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                min-height: 100%;
            }

            body {
                margin: 0;
                font-family: "Be Vietnam Pro", "Segoe UI", system-ui, sans-serif;
                color: var(--ink);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.25rem;
                position: relative;
                overflow-x: hidden;
                background: linear-gradient(135deg, #061a40 0%, #0d47a1 55%, #1e88e5 100%);
            }

            /* ================= HÌNH NỀN ĐỘNG ================= */

            .bg-blob {
                position: fixed;
                border-radius: 50%;
                filter: blur(70px);
                opacity: .45;
                z-index: 0;
                animation: floaty 12s ease-in-out infinite;
                pointer-events: none;
            }

                .bg-blob.b1 {
                    width: 380px;
                    height: 380px;
                    background: var(--sky);
                    top: -110px;
                    left: -90px;
                }

                .bg-blob.b2 {
                    width: 320px;
                    height: 320px;
                    background: var(--amber);
                    bottom: -120px;
                    right: -80px;
                    opacity: .3;
                    animation-delay: -4s;
                }

                .bg-blob.b3 {
                    width: 240px;
                    height: 240px;
                    background: #7c4dff;
                    top: 45%;
                    left: 55%;
                    opacity: .25;
                    animation-delay: -8s;
                }

            @@keyframes floaty {
                0%, 100% {
                    transform: translate(0, 0) scale(1);
                }

                50% {
                    transform: translate(30px, -30px) scale(1.08);
                }
            }

            /* ================= KHUNG CHÍNH ================= */

            .login-wrap {
                position: relative;
                z-index: 1;
                width: 100%;
                max-width: 1000px;
                display: flex;
                background: #fff;
                border-radius: 26px;
                overflow: hidden;
                box-shadow: 0 30px 70px rgba(3, 15, 45, .45);
                animation: rise .7s cubic-bezier(.2, .8, .2, 1) both;
            }

            @@keyframes rise {
                from {
                    opacity: 0;
                    transform: translateY(24px) scale(.98);
                }

                to {
                    opacity: 1;
                    transform: none;
                }
            }

            /* ================= CỘT TRÁI ================= */

            .brand-side {
                flex: 1 1 52%;
                position: relative;
                color: #fff;
                padding: 2.75rem 2.6rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                overflow: hidden;
                background: radial-gradient(circle at 15% 0%, rgba(255,255,255,.22) 0, transparent 42%), linear-gradient(165deg, #1e88e5 0%, #0d47a1 55%, #071f4d 100%);
            }

                .brand-side::before,
                .brand-side::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    border: 2px solid rgba(255,255,255,.14);
                    pointer-events: none;
                }

                .brand-side::before {
                    width: 340px;
                    height: 340px;
                    right: -130px;
                    bottom: -120px;
                }

                .brand-side::after {
                    width: 200px;
                    height: 200px;
                    right: -50px;
                    bottom: -40px;
                    background: rgba(255,255,255,.06);
                }

            .brand-top {
                display: flex;
                align-items: center;
                gap: .9rem;
                position: relative;
                z-index: 1;
            }

            /* ================= LOGO UNETI NỀN TRẮNG ================= */

            .brand-logo {
                width: 68px;
                height: 68px;
                min-width: 68px;
                border-radius: 20px;
                /* Nền trắng */
                background: #ffffff;
                /* Căn giữa ảnh */
                display: flex;
                align-items: center;
                justify-content: center;
                /* Khoảng cách giữa ảnh và viền */
                padding: 6px;
                /* Bo góc và không cho ảnh tràn */
                overflow: hidden;
                flex-shrink: 0;
                /* Viền trắng và bóng đổ */
                border: 2px solid rgba(255, 255, 255, .95);
                box-shadow: 0 4px 14px rgba(0, 0, 0, .16);
            }

                .brand-logo img {
                    display: block;
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                    object-position: center;
                    border-radius: 12px;
                }

            .brand-name {
                font-weight: 800;
                letter-spacing: .5px;
                font-size: 1.15rem;
                line-height: 1.25;
            }

                .brand-name small {
                    display: block;
                    font-weight: 500;
                    font-size: .72rem;
                    opacity: .85;
                    letter-spacing: 1.5px;
                    margin-top: 2px;
                }

            /* ================= NỘI DUNG GIỚI THIỆU ================= */

            .hero {
                position: relative;
                z-index: 1;
                margin: 2rem 0;
            }

                .hero .tag {
                    display: inline-flex;
                    align-items: center;
                    gap: .4rem;
                    background: rgba(255,183,3,.18);
                    color: #ffd166;
                    border: 1px solid rgba(255,183,3,.45);
                    padding: .3rem .8rem;
                    border-radius: 999px;
                    font-size: .78rem;
                    font-weight: 600;
                    margin-bottom: 1rem;
                }

                .hero h1 {
                    font-size: 2.15rem;
                    font-weight: 800;
                    line-height: 1.25;
                    margin: 0 0 .8rem;
                }

                    .hero h1 span {
                        color: #ffd166;
                    }

                .hero p {
                    color: rgba(255,255,255,.85);
                    margin: 0;
                    line-height: 1.6;
                }

            .features {
                list-style: none;
                padding: 0;
                margin: 1.6rem 0 0;
                display: grid;
                gap: .75rem;
            }

                .features li {
                    display: flex;
                    align-items: center;
                    gap: .85rem;
                    background: rgba(255,255,255,.1);
                    border: 1px solid rgba(255,255,255,.16);
                    border-radius: 14px;
                    padding: .7rem .9rem;
                    font-size: .92rem;
                    transition: transform .2s, background .2s;
                }

                    .features li:hover {
                        transform: translateX(6px);
                        background: rgba(255,255,255,.18);
                    }

                .features .ico {
                    flex: 0 0 38px;
                    height: 38px;
                    border-radius: 11px;
                    background: rgba(255,255,255,.2);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.1rem;
                }

                .features b {
                    display: block;
                    font-weight: 600;
                }

                .features span.d {
                    opacity: .8;
                    font-size: .8rem;
                }

            .brand-foot {
                position: relative;
                z-index: 1;
                font-size: .8rem;
                opacity: .75;
            }

            /* ================= CỘT PHẢI: FORM ================= */

            .form-side {
                flex: 1 1 48%;
                padding: 3rem 2.6rem;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .hello {
                font-size: 2rem;
                margin-bottom: .2rem;
            }

            .form-side h2 {
                font-weight: 800;
                color: var(--navy);
                margin: 0 0 .3rem;
                font-size: 1.65rem;
            }

            .form-side .sub {
                color: var(--muted);
                margin-bottom: 1.8rem;
                font-size: .95rem;
            }

            .form-label {
                font-weight: 600;
                color: #26364f;
                font-size: .86rem;
                margin-bottom: .35rem;
            }

            .field {
                display: flex;
                align-items: center;
                border: 1.5px solid var(--line);
                background: #f7faff;
                border-radius: 12px;
                transition: border-color .2s, box-shadow .2s, background .2s;
            }

                .field:focus-within {
                    border-color: var(--blue-500);
                    background: #fff;
                    box-shadow: 0 0 0 4px rgba(30, 136, 229, .14);
                }

                .field .lead {
                    padding: 0 .3rem 0 1rem;
                    color: var(--blue-600);
                    font-size: 1.1rem;
                    display: flex;
                }

                .field .form-control {
                    border: 0;
                    background: transparent;
                    box-shadow: none !important;
                    padding: .8rem .8rem;
                    font-size: .97rem;
                }

            .btn-toggle-pw {
                border: 0;
                background: transparent;
                color: var(--muted);
                padding: 0 1rem;
                font-size: 1.1rem;
            }

                .btn-toggle-pw:hover {
                    color: var(--blue-700);
                }

            .caps-warn {
                display: none;
                color: #b26a00;
                font-size: .8rem;
                margin-top: .35rem;
            }

                .caps-warn.show {
                    display: block;
                }

            .btn-login {
                position: relative;
                width: 100%;
                border: 0;
                color: #fff;
                font-weight: 700;
                font-size: 1rem;
                padding: .9rem;
                border-radius: 12px;
                background: linear-gradient(90deg, #0d47a1, #1e88e5);
                box-shadow: 0 10px 22px rgba(21, 101, 192, .35);
                transition: transform .15s, box-shadow .15s, filter .15s;
            }

                .btn-login:hover {
                    color: #fff;
                    transform: translateY(-2px);
                    box-shadow: 0 14px 28px rgba(21, 101, 192, .45);
                    filter: brightness(1.05);
                }

                .btn-login:active {
                    transform: translateY(0);
                }

                .btn-login:disabled {
                    opacity: .8;
                    cursor: wait;
                    transform: none;
                }

            .help-note {
                margin-top: 1.4rem;
                padding: .75rem .9rem;
                border-radius: 12px;
                background: #fff8e1;
                border: 1px solid #ffe29a;
                color: #7a5a00;
                font-size: .83rem;
                display: flex;
                gap: .6rem;
                align-items: flex-start;
            }

                .help-note i {
                    margin-top: .1rem;
                }

            /* Ẩn validation summary rỗng */
            .validation-summary-valid {
                display: none;
            }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 1.1rem;
            }

            /* ================= RESPONSIVE ================= */

            @@media (max-width: 860px) {
                .brand-side {
                    flex-basis: 45%;
                    padding: 2rem 1.6rem;
                }

                .hero h1 {
                    font-size: 1.7rem;
                }

                .form-side {
                    padding: 2.5rem 1.8rem;
                }
            }

            @@media (max-width: 767.98px) {
                body {
                    padding: 1rem;
                }

                .login-wrap {
                    flex-direction: column;
                    max-width: 460px;
                }

                .brand-side {
                    padding: 1.5rem 1.5rem 1.7rem;
                }

                .brand-logo {
                    width: 60px;
                    height: 60px;
                    min-width: 60px;
                    border-radius: 17px;
                }

                .hero, .features, .brand-foot {
                    display: none;
                }

                .brand-side::before,
                .brand-side::after {
                    display: none;
                }

                .form-side {
                    padding: 1.8rem 1.5rem 2rem;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                *, *::before, *::after {
                    animation: none !important;
                    transition: none !important;
                }
            }
    </style>
</head>

<body>
    <div class="bg-blob b1"></div>
    <div class="bg-blob b2"></div>
    <div class="bg-blob b3"></div>

    <div class="login-wrap">

        <!-- Cột trái: thương hiệu và giới thiệu -->
        <div class="brand-side">
            <div class="brand-top">

                <!-- Logo trường UNETI -->
                <div class="brand-logo">
                    <img src="@Url.Content("~/images/logo-uneti.png")"
                         alt="Logo Trường Đại học Kinh tế - Kỹ thuật Công nghiệp"
                         onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=&quot;bi bi-building&quot; style=&quot;color:#0d47a1;font-size:2rem&quot;></i>';" />
                </div>

                <div class="brand-name">
                    KTX UNETI
                    <small>KÝ TÚC XÁ SINH VIÊN</small>
                </div>
            </div>

            <div class="hero">
                <div class="tag">
                    <i class="bi bi-stars"></i>
                    Cổng thông tin sinh viên
                </div>

                <h1>
                    Một nơi ở ổn định,
                    <br />
                    <span>một hành trình học tập trọn vẹn.</span>
                </h1>

                <p>
                    Đăng ký chỗ ở, theo dõi phòng và xem lịch sử lưu trú của bạn,
                    tất cả trên một hệ thống.
                </p>

                <ul class="features">
                    <li>
                        <span class="ico">
                            <i class="bi bi-journal-check"></i>
                        </span>
                        <div>
                            <b>Đăng ký trực tuyến</b>
                            <span class="d">Nộp nguyện vọng ở KTX chỉ vài thao tác</span>
                        </div>
                    </li>

                    <li>
                        <span class="ico">
                            <i class="bi bi-door-open"></i>
                        </span>
                        <div>
                            <b>Xem phòng, loại phòng</b>
                            <span class="d">Thông tin phòng và số chỗ còn trống</span>
                        </div>
                    </li>

                    <li>
                        <span class="ico">
                            <i class="bi bi-clock-history"></i>
                        </span>
                        <div>
                            <b>Theo dõi lịch sử ở</b>
                            <span class="d">Mọi thông tin phân phòng của bạn</span>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="brand-foot">
                © @DateTime.Now.Year Trường Đại học Kinh tế - Kỹ thuật Công nghiệp
            </div>
        </div>

        <!-- Cột phải: form đăng nhập -->
        <div class="form-side">
            <div class="hello">👋</div>

            <h2>Chào mừng trở lại!</h2>
            <p class="sub">Đăng nhập để quản lý chỗ ở ký túc xá của bạn.</p>

            <form asp-action="Login" method="post" id="frmLogin" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>

                    <div class="field">
                        <span class="lead">
                            <i class="bi bi-person-fill"></i>
                        </span>

                        <input asp-for="TenDangNhap"
                               class="form-control"
                               placeholder="Nhập tên đăng nhập"
                               autocomplete="username"
                               autofocus />
                    </div>

                    <span asp-validation-for="TenDangNhap"
                          class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MatKhau" class="form-label"></label>

                    <div class="field">
                        <span class="lead">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                        <input asp-for="MatKhau"
                               type="password"
                               class="form-control"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password" />

                        <button type="button"
                                class="btn-toggle-pw"
                                id="btnTogglePw"
                                tabindex="-1"
                                aria-label="Hiện hoặc ẩn mật khẩu">
                            <i class="bi bi-eye" id="iconTogglePw"></i>
                        </button>
                    </div>

                    <div class="caps-warn" id="capsWarn">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Caps Lock đang bật
                    </div>

                    <span asp-validation-for="MatKhau"
                          class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-login" id="btnLogin">
                    <span id="loginText">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Đăng nhập
                    </span>

                    <span id="loginLoading" class="d-none">
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        Đang đăng nhập...
                    </span>
                </button>
            </form>

            <div class="help-note">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    Quên mật khẩu hoặc chưa có tài khoản?
                    Vui lòng liên hệ Ban quản lý KTX để được hỗ trợ.
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
            // Lấy ô nhập mật khẩu
            var pw = document.getElementById('MatKhau');

            // Hiện hoặc ẩn mật khẩu
            document.getElementById('btnTogglePw').addEventListener('click', function () {
                var icon = document.getElementById('iconTogglePw');
                var an = pw.type === 'password';

                pw.type = an ? 'text' : 'password';
                icon.className = an ? 'bi bi-eye-slash' : 'bi bi-eye';
            });

            // Cảnh báo Caps Lock
            pw.addEventListener('keyup', function (e) {
                document.getElementById('capsWarn').classList.toggle(
                    'show',
                    e.getModifierState && e.getModifierState('CapsLock')
                );
            });

            pw.addEventListener('blur', function () {
                document.getElementById('capsWarn').classList.remove('show');
            });

            // Hiệu ứng đang đăng nhập
            $('#frmLogin').on('submit', function () {
                if (typeof $(this).valid === 'function' && !$(this).valid()) {
                    return;
                }

                $('#btnLogin').prop('disabled', true);
                $('#loginText').addClass('d-none');
                $('#loginLoading').removeClass('d-none');
            });
    </script>
</body>
</html>
